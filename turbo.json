{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "format:fix": {
      "dependsOn": ["^format:fix"]
    },
    "check-locale-files": {
      "dependsOn": ["^check-locale-files"]
    },
    "lint:check": {
      "dependsOn": ["^lint:check"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["**/dist/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "**/dist/**",
        "apps/server/public/**",
        "apps/client/src/generatedClient/**"
      ]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:e2e": {
      "dependsOn": ["^test:e2e"]
    },
    "validate": {
      "dependsOn": [
        "format:check",
        "check-locale-files",
        "lint:check",
        "check-types",
        "test"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
