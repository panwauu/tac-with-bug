{
  "version": "1.7.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check-types": "turbo run check-types",
    "check-format": "turbo run check-format",
    "prettier:format": "turbo run prettier:format",
    "check-locale-files": "turbo run check-locale-files",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "dev": "turbo run dev",
    "validate": "turbo run lint check-format check-types check-locale-files test",
    "validate-and-fix": "turbo run lint:fix && turbo run prettier:format && npm run validate"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "vitest": "^5.0.5"
  },
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
